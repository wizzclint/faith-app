{
  "expo": {
    "name": "faith-app",
    "slug": "faith-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.faitharcade.faithrun"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#08090D"
      },
      "package": "com.faitharcade.faithrun"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "0875e71b-866c-416c-816e-39aaa829e091"
      }
    },
    "owner": "wizzclint",
    "plugins": [
      "expo-audio"
    ]
  }
}
